# ==============================================================================
# Talvora Backend Environment Configuration (Example Baseline)
# ==============================================================================
# Copy this file to .env for local development. Never commit real credentials.

# --- Environment & Runtime ---
TALVORA_ENVIRONMENT=local
TALVORA_DEBUG=true
TALVORA_LOG_LEVEL=INFO
TALVORA_SERVICE_NAME=talvora-backend
TALVORA_ALLOWED_HOSTS=["localhost", "127.0.0.1"]
TALVORA_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- Database (PostgreSQL 17) ---
# Format: postgresql+psycopg://user:password@host:port/dbname
TALVORA_DATABASE_URL=postgresql+psycopg://talvora:talvora_local_dev@localhost:5432/talvora_db
TALVORA_DB_POOL_SIZE=10
TALVORA_DB_MAX_OVERFLOW=5
TALVORA_DB_TIMEOUT_SECONDS=5.0

# --- Object Storage (S3 / Moto) ---
TALVORA_S3_BUCKET_NAME=talvora-quarantine-local
TALVORA_S3_CLEAN_BUCKET_NAME=talvora-clean-local
TALVORA_AWS_REGION=us-east-1
# Set MOTO_ENDPOINT_URL only for local development; must be empty in production
TALVORA_MOTO_ENDPOINT_URL=http://localhost:5000
TALVORA_S3_KMS_KEY_ID=

# --- Messaging & SQS ---
TALVORA_SQS_QUEUE_URL=http://localhost:5000/123456789012/talvora-tasks-local
TALVORA_SQS_DLQ_URL=http://localhost:5000/123456789012/talvora-tasks-dlq-local

# --- Authentication & Identity (OIDC / Cognito) ---
TALVORA_OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example
TALVORA_OIDC_CLIENT_ID=example-client-id
TALVORA_OIDC_CLIENT_SECRET=example-client-secret
# Set to true only in local/test to allow mocked OIDC flow without cloud credentials
TALVORA_ALLOW_DEV_IDENTITY_ADAPTER=true

# --- Security & Cookies ---
TALVORA_COOKIE_SECURE=false
TALVORA_SESSION_COOKIE_NAME=talvora_session
TALVORA_CSRF_SECRET=local-development-csrf-secret-change-in-production-min32chars
TALVORA_ENCRYPTION_KEY=local-dev-aes-encryption-key-32bytes-long!

# --- Metrics & Internal Diagnostics ---
TALVORA_INTERNAL_METRICS_ENABLED=true
TALVORA_INTERNAL_DIAGNOSTIC_ENABLED=true
