+                        "competency_id": comp2_id,
+                        "rating": "3",
+                        "observation": "Good.",
+                    },
+                ],
+            },
+            headers={"X-CSRF-Token": int_csrfs["int2"], "Origin": "http://testserver"},
+        )
+        assert withdrawn_amend.status_code == 409
