+        for table in reversed(_TABLES):
+            op.execute(
+                sa.text(f"DROP POLICY IF EXISTS {table}_tenant_isolation_policy ON {table};")
+            )
+    for table in reversed(_TABLES):
+        op.drop_table(table)
