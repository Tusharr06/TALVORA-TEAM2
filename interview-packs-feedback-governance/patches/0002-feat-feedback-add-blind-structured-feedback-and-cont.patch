+                    CREATE POLICY {table}_tenant_isolation_policy ON {table}
+                    FOR ALL
+                    USING (
+                        tenant_id = NULLIF(current_setting('app.current_tenant_id', true), '')::uuid
+                    )
+                    WITH CHECK (
+                        tenant_id = NULLIF(current_setting('app.current_tenant_id', true), '')::uuid
+                    );
+                    """
+                )
+            )
