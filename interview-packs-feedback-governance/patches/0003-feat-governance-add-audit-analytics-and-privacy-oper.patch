+                        SELECT 1 FROM organizations WHERE id = OLD.tenant_id
+                    ) THEN
+                        RAISE EXCEPTION 'audit_event is append-only: DELETE denied';
+                    END IF;
+                    RETURN OLD;
+                END;
+                $$ LANGUAGE plpgsql;
+                """
+            )
