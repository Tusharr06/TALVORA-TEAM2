+
+def compute_opaque_subject_hash(tenant_id: UUID, candidate_id: UUID) -> str:
+    """Derives a non-PII opaque subject hash scoped to `(tenant_id, candidate_id)`."""
+    return hmac.new(
+        str(tenant_id).encode("utf-8"),
+        str(candidate_id).encode("utf-8"),
+        hashlib.sha256,
+    ).hexdigest()
