+        )
+        now = uow.clock.now()
+        uow.commit()
+        return AuditEventExportResponse(
+            exported_at=now,
+            count=len(items),
+            governance_disclosure=AUDIT_GOVERNANCE_DISCLOSURE,
+            items=[
+                AuditEventResponse(
