+def _percentile(samples_ms: list[float], pct: float) -> float:
+    if not samples_ms:
+        return 0.0
+    ordered = sorted(samples_ms)
+    idx = max(0, min(len(ordered) - 1, math.ceil((pct / 100.0) * len(ordered)) - 1))
+    return round(ordered[idx], 2)
+
