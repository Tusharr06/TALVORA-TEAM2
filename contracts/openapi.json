{
  "openapi": "3.1.0",
  "info": {
    "title": "Talvora Talent Operations API",
    "description": "Enterprise Talent Operations Workspace backend for intelligent recruitment workflows.",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness Probe",
        "description": "Unauthenticated liveness probe.\n\nIndicates the FastAPI application process is alive and accepting connections.\nDoes NOT depend on external database, cloud, or AI availability.",
        "operationId": "check_liveness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness Probe",
        "description": "Readiness probe checking core database and dependency availability.\n\nReturns HTTP 200 when core database is healthy.\nReturns HTTP 503 if core relational persistence is unreachable.\nOptional integrations appear as degraded capabilities rather than taking down the service.",
        "operationId": "check_readiness",
        "responses": {
          "200": {
            "description": "Service is ready to handle traffic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatusResponse"
                }
              }
            }
          },
          "503": {
            "description": "Core dependencies are unavailable"
          }
        }
      }
    },
    "/internal/diagnostic": {
      "get": {
        "tags": [
          "Internal"
        ],
        "summary": "Internal Diagnostic Surface",
        "description": "Non-production diagnostic route for runtime verification.\n\nActive strictly in local or test environments. Returns 404 in staging/production.",
        "operationId": "get_internal_diagnostic",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Get Internal Diagnostic"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operations/{operation_id}": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Get Operation Status",
        "description": "Retrieves current execution status, timings, result, and errors for a task.",
        "operationId": "get_operation_status",
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Operation Id"
            }
          },
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Tenant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operations/{operation_id}/retry": {
      "post": {
        "tags": [
          "Operations"
        ],
        "summary": "Retry Failed Operation",
        "description": "Re-enqueues a failed or retry-waiting operation for execution.",
        "operationId": "retry_operation",
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Operation Id"
            }
          },
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operations/{operation_id}/cancel": {
      "post": {
        "tags": [
          "Operations"
        ],
        "summary": "Cancel Pending Operation",
        "description": "Cancels a pending or retry-waiting operation before execution.",
        "operationId": "cancel_operation",
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Operation Id"
            }
          },
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operations/test-diagnostic": {
      "post": {
        "tags": [
          "Operations"
        ],
        "summary": "Admit Test Diagnostic Operation",
        "description": "Internal test admission endpoint demonstrating transactional outbox.\n\nActive strictly in local and test environments.",
        "operationId": "admit_test_diagnostic_operation",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-User-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Admit Test Diagnostic Operation"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComponentHealth": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Name of the component"
          },
          "healthy": {
            "type": "boolean",
            "title": "Healthy",
            "description": "Whether the component is operational"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Detailed status message"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms",
            "description": "Health check round-trip latency in milliseconds"
          }
        },
        "type": "object",
        "required": [
          "name",
          "healthy",
          "status",
          "latency_ms"
        ],
        "title": "ComponentHealth"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthStatusResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall service health: healthy, degraded, or unhealthy"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Service name"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "Active environment"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentHealth"
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "environment"
        ],
        "title": "HealthStatusResponse"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "alive"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Service name"
          }
        },
        "type": "object",
        "required": [
          "service"
        ],
        "title": "LivenessResponse"
      },
      "OperationResponse": {
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id",
            "description": "Unique operation UUID"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "title": "Tenant Id",
            "description": "Owning organization tenant ID"
          },
          "operation_type": {
            "type": "string",
            "title": "Operation Type",
            "description": "Type of background workload"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current lifecycle status"
          },
          "resource_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Id",
            "description": "Bound resource entity ID"
          },
          "retry_count": {
            "type": "integer",
            "title": "Retry Count",
            "description": "Number of attempts performed"
          },
          "max_retries": {
            "type": "integer",
            "title": "Max Retries",
            "description": "Maximum allowed retries"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Admission timestamp"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Last status update timestamp"
          },
          "result": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result",
            "description": "Output payload upon success"
          },
          "error_detail": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Detail",
            "description": "Safe error information"
          }
        },
        "type": "object",
        "required": [
          "operation_id",
          "tenant_id",
          "operation_type",
          "status",
          "retry_count",
          "max_retries",
          "created_at",
          "updated_at"
        ],
        "title": "OperationResponse",
        "description": "Operation tracking status response."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}