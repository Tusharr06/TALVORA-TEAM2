# syntax=docker/dockerfile:1
FROM python:3.13-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Install runtime dependencies and security utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager
COPY --from=ghcr.io/astral-sh/uv:0.5.28 /uv /uvx /bin/

WORKDIR /app

# Non-root unprivileged runtime user
RUN groupadd -g 10001 talvora && \
    useradd -u 10001 -g talvora -s /bin/bash -m talvora

# Copy dependency manifests
COPY pyproject.toml ./

# Install dependencies using uv into system environment
RUN uv pip install --system -e .

# Copy application source code
COPY src/ /app/src/

USER talvora

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

CMD ["uvicorn", "talvora.main:app", "--host", "0.0.0.0", "--port", "8000"]
