+
+class InterviewContextResponse(BaseModel):
+    interview_id: UUID
+    application_id: UUID
+    job_id: UUID
+    candidate_id: UUID
+    stage: str
+    seniority_level: str
+    duration_minutes: int
+    schedule_revision: int
+    status: str
+    timezone: str
+    participant_user_ids: list[UUID]
+    admitted_operation_id: UUID | None = None
